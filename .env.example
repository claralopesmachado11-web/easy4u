# Copie para .env (nunca envie o .env para o repositório). Em produção, use o Azure Key Vault.
NODE_ENV=production
PORT=3000
APP_URL=https://central.suaempresa.com.br
TRUST_PROXY=true
DB_SSL=require
DATABASE_URL_AUTH=postgres://app_auth:SENHA@servidor.postgres.database.azure.com:5432/central
DATABASE_URL_RUNTIME=postgres://app_runtime:SENHA@servidor.postgres.database.azure.com:5432/central
DATABASE_URL_WORKER=postgres://app_worker:SENHA@servidor.postgres.database.azure.com:5432/central
DATABASE_URL_OWNER=postgres://app_owner:SENHA@servidor.postgres.database.azure.com:5432/central
# gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
SESSION_HOURS=10
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Central de Demandas <nao-responda@suaempresa.com.br>
# Registro do app no Microsoft 365 (feito pela TI)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SYNC_INTERVAL_MINUTES=5
# Opcional: Azure OpenAI da empresa
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_KEY=
